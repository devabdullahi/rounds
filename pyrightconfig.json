{
  // Editor import resolution for the Python tools (Pylance reads this). Each tool folder runs as its
  // own script directory, and kb-generate also imports kb-import's helpers via sys.path at runtime,
  // which the checker can't follow on its own.
  "executionEnvironments": [
    { "root": "tools/kb-generate", "extraPaths": ["tools/kb-import"] },
    { "root": "tools/kb-import" }
  ],
  "exclude": ["**/__pycache__", "Rounds - IOS/build", "knowledge-base/licensed"]
}
