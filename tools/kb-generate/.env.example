# Keys for the profile generator. Copy to .env (git-ignored); never commit real keys.
# Variables already set in the shell win over this file.

# deepseek (default) | anthropic | openai | mock (offline dry run; writes to KB_OUT or a temp folder)
LLM_PROVIDER=
# Optional: overrides the provider's default model.
LLM_MODEL=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# UMLS key (uts.nlm.nih.gov → My Profile → API Key) for the SNOMED CT checks in terminology.py.
UMLS_API_KEY=
