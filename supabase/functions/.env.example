# Edge function settings. Copy to supabase/functions/.env for local runs (git-ignored);
# in the cloud set each with `supabase secrets set NAME=value`.

# Model for case writing, patient replies, grading and profiles: deepseek (default) | anthropic | openai
LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# UMLS key (uts.nlm.nih.gov → My Profile): SNOMED CT checks while writing profiles.
UMLS_API_KEY=

# Daily limits per student on model-backed actions (defaults shown).
# LIMIT_CASES_PER_DAY=10
# LIMIT_QUESTIONS_PER_DAY=200
# LIMIT_CARD_DECKS_PER_DAY=3
