// Copy to Secrets.xcconfig (git-ignored) and fill in from Supabase → Project Settings → API.
// The anon key is designed to ship in apps; security comes from row-level security, not secrecy.
// xcconfig treats "//" as a comment, so write the URL with $() between the slashes:
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
// Google Sign-In: the iOS OAuth client ID, and the same ID reversed as a URL scheme.
GOOGLE_IOS_CLIENT_ID = 123456789-abc.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789-abc
