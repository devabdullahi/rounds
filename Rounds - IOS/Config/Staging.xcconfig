// Staging build configuration: the same settings as Release, pointed at the palpo-staging Supabase
// project instead of production. TestFlight builds for testers are archived with this
// configuration ("Rounds Staging" scheme); App Store builds use Release.
#include "Base.xcconfig"
// Git-ignored: the staging project's URL and anon key (see Secrets.example.xcconfig for the format).
#include? "Secrets.staging.xcconfig"
ROUNDS_ENVIRONMENT = staging
