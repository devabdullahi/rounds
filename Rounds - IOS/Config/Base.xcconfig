// Shared build settings. Supabase connection values come from Secrets.xcconfig (git-ignored).
// Copy Secrets.example.xcconfig to Secrets.xcconfig and fill it in when it's time to connect.
SUPABASE_URL =
SUPABASE_ANON_KEY =
// Google Sign-In (Google Cloud → Credentials → iOS OAuth client). The reversed ID is the client ID
// read backwards ("com.googleusercontent.apps.123-abc"); it's the URL scheme Google returns to.
// Empty until set: the Google button then explains it isn't configured.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.unset
#include? "Secrets.xcconfig"
